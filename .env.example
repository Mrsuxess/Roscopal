# ROSCOPAL Environment Configuration
PORT=5000
NODE_ENV=development

# PayPal Sandbox Credentials
# Leave as defaults to run in high-fidelity SIMULATED_SANDBOX mode with full deterministic validation.
# Provide active credentials to switch automatically to LIVE_SANDBOX REST API execution.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (obtained when subscribing your webhook in PayPal Developer Portal)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Optional LLM API Router (for AI Assistant natural language classification)
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_AUTH_TOKEN=your_token_here
