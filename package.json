{
  "name": "roscopal-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "start": "npm --prefix server run start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "test:scenarios": "npm --prefix server run test:scenarios",
    "test:security": "npm --prefix server run test:security",
    "test:paypal": "npm --prefix server run test:paypal"
  }
}
