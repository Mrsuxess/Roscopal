{
  "name": "roscopal-server",
  "version": "1.0.0",
  "description": "ROSCOPAL Backend API and AI Rules Engine",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test:scenarios": "tsx src/tests/runScenarios.ts",
    "test:security": "tsx src/tests/securityAndConcurrencyTests.ts",
    "test:paypal": "tsx src/tests/paypalIntegrationTests.ts",
    "test:auth": "tsx src/tests/authAndCircleTests.ts",
    "test:amounts": "tsx src/tests/amountMismatchAndAiTests.ts",
    "test": "tsx src/tests/authAndCircleTests.ts && tsx src/tests/amountMismatchAndAiTests.ts && tsx src/tests/securityAndConcurrencyTests.ts && tsx src/tests/runScenarios.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "sql.js": "^1.12.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/sql.js": "^1.4.9",
    "typescript": "^5.7.2"
  }
}
